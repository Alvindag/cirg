.vscode/
.idea/
*.swp

# Release signing material
src/mobile/android/key.properties
*.jks
*.keystore

# ── DAS Trust Hub platform: never commit data, secrets or sessions ──
platform/**/.env
platform/**/instance/
platform/demo-data/
platform/itam/uploads/*
!platform/itam/uploads/.gitkeep
platform/**/*.db
platform/**/.secret_key
