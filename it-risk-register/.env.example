# Copy to .env and fill in real values. Never commit .env.

DB_NAME=itriskregister
DB_USER=itriskregister
DB_PASSWORD=change-me

DASHBOARD_SECRET_KEY=change-me-to-a-random-64-char-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional: NVD API key raises the rate limit from 5 requests/30s to 50/30s.
# Request one free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# How often the collector recomputes risk scores / re-syncs NVD (seconds)
RISK_RECOMPUTE_INTERVAL_SECONDS=3600
NVD_SYNC_INTERVAL_SECONDS=86400

# Active nmap vulnerability scanning — OFF by default. Only enable this
# against hosts you are authorized to scan; see README "Active scanning"
# before turning it on. Scans every asset with an ip_address set.
NMAP_SCAN_ENABLED=false
NMAP_SCAN_INTERVAL_SECONDS=86400
NMAP_SCRIPTS=vuln,vulners
# Drop findings below this CVSS score from the vulners script (0 = keep all)
NMAP_MIN_CVSS=0
# nmap timing template: -T2 (polite/slow, less disruptive) .. -T4 (aggressive/fast)
NMAP_TIMING=-T3
