# CIRG — Cyber Incident Report Generator
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Shared PostgreSQL database (same as CFEMS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cfems
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server
CIRG_PORT=5001
FLASK_DEBUG=False

# Secret used to sign dashboard-user JWT session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# MUST be set to a fixed value in production — if unset, a random key is
# generated per process start and all sessions are invalidated on restart.
SECRET_KEY=

# Enterprise Security Operations (SOC) module
REPORTS_DIR=reports
AGENT_OFFLINE_THRESHOLD_SECONDS=180
ENROLLMENT_TOKEN_TTL_HOURS=24
