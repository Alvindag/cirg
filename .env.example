# CIRG — Cyber Incident Report Generator
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Shared PostgreSQL database (same as CFEMS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cfems
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server
CIRG_PORT=5001
FLASK_DEBUG=False
