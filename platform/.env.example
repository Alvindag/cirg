# Copy to .env (never commit .env). Generate secrets with: python -c "import secrets;print(secrets.token_hex(32))"
SSO_SECRET=                # >=32 chars, identical for hub, itam and cybershield; enables single sign-on
INTEGRATION_TOKEN=         # >=32 chars, identical for hub, itam and cybershield; enables joiner auto-enrolment + certificate sync
ITAM_INTERNAL_URL=http://itam:5057            # how the Hub server reaches the apps (compose service names)
CYBERSHIELD_INTERNAL_URL=http://cybershield:5076
HUB_SECRET_KEY=
ITAM_SECRET_KEY=
SECRET_KEY=                # CyberShield session key
HUB_ADMIN_PASSWORD=        # optional first-run Hub admin password (else a random one is printed once)
HUB_API_TOKEN=             # optional bearer token (>=32 chars) for /api/v1/summary
HUB_AUTO_SYNC_SECONDS=300  # seal source audit trails into the ledger automatically
COOKIE_SECURE=true         # true behind HTTPS
ITAM_URL=https://itam.example.com
CYBERSHIELD_URL=https://training.example.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ESCALATION_EMAIL=
DEBUG_MODE=false
