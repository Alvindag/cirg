# Copy to .env (never commit .env). Generate secrets with: python -c "import secrets;print(secrets.token_hex(32))"
SSO_SECRET=                # >=32 chars, identical for hub, itam and cybershield; enables single sign-on
INTEGRATION_TOKEN=         # >=32 chars, identical for hub, itam and cybershield; enables joiner auto-enrolment + certificate sync
ITAM_INTERNAL_URL=http://itam:5057            # how the Hub server reaches the apps (compose service names)
CYBERSHIELD_INTERNAL_URL=http://cybershield:5076
HUB_SECRET_KEY=
ITAM_SECRET_KEY=
SECRET_KEY=                # CyberShield session key
HUB_ADMIN_PASSWORD=        # optional first-run Hub admin password (else a random one is printed once)
HUB_API_TOKEN=             # optional bearer token (>=32 chars) for /api/v1/summary
HUB_AUTO_SYNC_SECONDS=300  # seal source audit trails into the ledger automatically
COOKIE_SECURE=true         # true behind HTTPS
ITAM_URL=https://itam.example.com
CYBERSHIELD_URL=https://training.example.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ESCALATION_EMAIL=
DEBUG_MODE=false

# ── Hub links ──
HUB_URL=https://hub.example.com   # shows an "Offboarding (Trust Hub)" link in the ITAM menu

# ── On-premise Active Directory (optional; leaver account disabling) ──
# Leave AD_URL empty and the AD step is a normal manual checklist step.
AD_URL=                          # must be ldaps://dc.example.local:636 (plain ldap:// is refused)
AD_BIND_DN=                      # dedicated service account with delegated rights only, NOT a domain admin
AD_BIND_PASSWORD=
AD_BASE_DN=                      # e.g. DC=das,DC=local (or the OU holding staff)
AD_CA_CERT=                      # path to the CA that signed the domain controller certificate
AD_EMPLOYEE_ID_ATTR=employeeID
AD_DISABLED_OU=                  # optional: move disabled accounts here (needs extra delegated rights)
AD_DRY_RUN=true                  # KEEP true until a pilot has been checked; set false to go live
AD_AUTO_DISABLE=false            # true = disable confirmed accounts automatically on the last working day
AD_PROTECTED_GROUPS=             # optional override of the protected-group list
AD_PROTECTED_USERS=              # extra accounts that must never be touched, comma separated
