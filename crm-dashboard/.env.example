# --- Option A: use a real DAS Engage 360 API instead of the built-in backend ---
# Leave unset to use the built-in backend and sample data.
# Server-side only: the browser reaches the API through the /das-api proxy.
# DAS_API_BASE_URL=http://localhost:5000

# --- Option B: Microsoft Entra sign-in for the built-in backend ---
# All four are needed. With none of them set, development uses the demo role picker,
# and production refuses to run unless ALLOW_DEMO_AUTH=true.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# At least 32 random characters, e.g. openssl rand -base64 48
# AUTH_SESSION_SECRET=
# The public address of the app (used for the redirect URI /auth/callback).
# APP_BASE_URL=http://localhost:3000
# The first administrator, created on their first Microsoft sign-in.
# ENTRA_BOOTSTRAP_ADMIN_EMAIL=

# Production demo only. Lets anyone pick any role. Never with real data.
# ALLOW_DEMO_AUTH=true
