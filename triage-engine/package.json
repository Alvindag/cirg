{
  "name": "triage-engine",
  "private": true,
  "version": "0.1.0",
  "description": "Client-side Windows Security Event Log triage engine (zero-trust, no network)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-validator.mjs --check && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "npm audit --omit=dev",
    "e2e": "npm run build && node e2e/gate.mjs",
    "preview:secure": "vite build && node -e \"import('./e2e/server.mjs').then(async m=>{const s=await m.serve(process.cwd()+'/dist',4173);console.log('http://127.0.0.1:4173')})\"",
    "gen:validator": "node scripts/build-validator.mjs",
    "pretest": "node scripts/build-validator.mjs --check",
    "build:evtx": "node scripts/build-evtx.mjs",
    "sbom": "node scripts/sbom.mjs"
  },
  "dependencies": {
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0",
    "yaml": "2.9.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.13.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
