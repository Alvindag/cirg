{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "skipLibCheck": true, "isolatedModules": true, "types": ["vite/client", "node"], "resolveJsonModule": true, "noEmit": true
  },
  "include": ["src", "tests", "vite.config.ts"]
}
