{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/schemas/triage-report.schema.json",
  "title": "Windows Security Triage Report v1.0",
  "description": "Structured export of a triage run. Timestamps are ISO-8601 UTC. When redaction.applied is true, account/host/IP/SID values are stable pseudonyms and command lines are removed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "generatedAt",
    "tool",
    "redaction",
    "source",
    "executiveSummary",
    "chains",
    "findings",
    "attackCoverage",
    "methodology",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "windows-security-triage-report"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "redaction": {
      "type": "object",
      "required": [
        "applied",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "fileName",
        "format",
        "sizeBytes",
        "records",
        "parsedEvents",
        "rejectedRecords",
        "firstEvent",
        "lastEvent",
        "hostCount"
      ],
      "additionalProperties": false,
      "properties": {
        "fileName": {
          "type": "string"
        },
        "format": {
          "enum": [
            "csv",
            "json",
            "xml",
            "evtx"
          ]
        },
        "sizeBytes": {
          "type": "integer"
        },
        "records": {
          "type": "integer"
        },
        "parsedEvents": {
          "type": "integer"
        },
        "rejectedRecords": {
          "type": "integer"
        },
        "firstEvent": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastEvent": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostCount": {
          "type": "integer"
        }
      }
    },
    "executiveSummary": {
      "type": "object",
      "required": [
        "risk",
        "headline",
        "counts",
        "topThreats",
        "recommendedActions"
      ],
      "additionalProperties": false,
      "properties": {
        "risk": {
          "type": "object",
          "required": [
            "score",
            "label",
            "components"
          ],
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "label": {
              "enum": [
                "Critical",
                "High",
                "Medium",
                "Low",
                "Informational"
              ]
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "points"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "points": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "headline": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "required": [
            "chains",
            "findings",
            "bySeverity"
          ],
          "additionalProperties": false,
          "properties": {
            "chains": {
              "type": "integer"
            },
            "findings": {
              "type": "integer"
            },
            "bySeverity": {
              "type": "object",
              "required": [
                "info",
                "low",
                "medium",
                "high",
                "critical"
              ],
              "additionalProperties": false,
              "properties": {
                "info": {
                  "type": "integer"
                },
                "low": {
                  "type": "integer"
                },
                "medium": {
                  "type": "integer"
                },
                "high": {
                  "type": "integer"
                },
                "critical": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "topThreats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "id",
              "title",
              "score"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "chain",
                  "finding"
                ]
              },
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "score": {
                "type": "integer"
              }
            }
          }
        },
        "recommendedActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "risk",
          "firstSeen",
          "lastSeen",
          "hosts",
          "accounts",
          "ips",
          "stages",
          "linkedBecause",
          "narrative",
          "findingIds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "risk": {
            "type": "object",
            "required": [
              "score",
              "label",
              "components"
            ],
            "additionalProperties": false,
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "label": {
                "enum": [
                  "Critical",
                  "High",
                  "Medium",
                  "Low",
                  "Informational"
                ]
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "points"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "points": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "firstSeen": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time"
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accounts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ips": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "tactic"
              ],
              "additionalProperties": false,
              "properties": {
                "tactic": {
                  "type": "string"
                },
                "tacticName": {
                  "type": "string"
                }
              }
            }
          },
          "linkedBecause": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "narrative": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "time",
                "findingId",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "time": {
                  "type": "string",
                  "format": "date-time"
                },
                "findingId": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "findingIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ruleId",
          "ruleName",
          "kind",
          "severity",
          "confidence",
          "score",
          "attack",
          "count",
          "firstSeen",
          "lastSeen",
          "entities",
          "evidence",
          "evidenceShown",
          "evidenceTruncated",
          "suppressedEvents",
          "context",
          "nextSteps"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "ruleId": {
            "type": "string"
          },
          "ruleName": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "match",
              "threshold",
              "sequence"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "attack": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "tactic",
                "technique"
              ],
              "additionalProperties": false,
              "properties": {
                "tactic": {
                  "type": "string",
                  "pattern": "^TA\\d{4}$"
                },
                "tacticName": {
                  "type": "string"
                },
                "technique": {
                  "type": "string",
                  "pattern": "^T\\d{4}(\\.\\d{3})?$"
                },
                "techniqueName": {
                  "type": "string"
                }
              }
            }
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "firstSeen": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time"
          },
          "host": {
            "type": "string"
          },
          "group": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "distinctCount": {
            "type": "integer"
          },
          "chainId": {
            "type": "string"
          },
          "entities": {
            "type": "object",
            "required": [
              "accounts",
              "hosts",
              "ips"
            ],
            "additionalProperties": false,
            "properties": {
              "accounts": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "ips": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "time",
                "eventId",
                "fields"
              ],
              "additionalProperties": false,
              "properties": {
                "time": {
                  "type": "string",
                  "format": "date-time"
                },
                "eventId": {
                  "type": "integer"
                },
                "computer": {
                  "type": "string"
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                }
              }
            }
          },
          "evidenceShown": {
            "type": "integer"
          },
          "evidenceTruncated": {
            "type": "boolean"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "events"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "time",
                      "eventId",
                      "fields"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "time": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "eventId": {
                        "type": "integer"
                      },
                      "computer": {
                        "type": "string"
                      },
                      "fields": {
                        "type": "object",
                        "additionalProperties": {
                          "type": [
                            "string",
                            "number"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "suppressedEvents": {
            "type": "integer"
          },
          "context": {
            "type": "object",
            "required": [
              "maliciousIndicators",
              "legitimateExplanations",
              "references"
            ],
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string"
              },
              "maliciousIndicators": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "legitimateExplanations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "nextSteps": {
            "type": "object",
            "required": [
              "investigate",
              "remediate"
            ],
            "additionalProperties": false,
            "properties": {
              "investigate": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "title",
                    "unfilled"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "shell": {
                      "type": "string"
                    },
                    "risk": {
                      "enum": [
                        "read-only",
                        "disruptive"
                      ]
                    },
                    "command": {
                      "type": "string"
                    },
                    "unfilled": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "remediate": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "title",
                    "unfilled"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "shell": {
                      "type": "string"
                    },
                    "risk": {
                      "enum": [
                        "read-only",
                        "disruptive"
                      ]
                    },
                    "command": {
                      "type": "string"
                    },
                    "unfilled": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "attackCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tactic",
          "techniques"
        ],
        "additionalProperties": false,
        "properties": {
          "tactic": {
            "type": "string"
          },
          "tacticName": {
            "type": "string"
          },
          "techniques": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "technique",
                "ruleIds",
                "findingIds"
              ],
              "additionalProperties": false,
              "properties": {
                "technique": {
                  "type": "string"
                },
                "techniqueName": {
                  "type": "string"
                },
                "ruleIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "findingIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "methodology": {
      "type": "object",
      "required": [
        "rulePacks",
        "attackVersion",
        "ruleLoadErrors",
        "ruleLoadWarnings"
      ],
      "additionalProperties": false,
      "properties": {
        "rulePacks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "version",
              "rules"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "rules": {
                "type": "integer"
              }
            }
          }
        },
        "attackVersion": {
          "type": "string"
        },
        "ruleLoadErrors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ruleLoadWarnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
