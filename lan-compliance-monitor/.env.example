# Copy to .env and fill in real values. Never commit .env.

DB_NAME=lancompliance
DB_USER=lancompliance
DB_PASSWORD=change-me

DASHBOARD_SECRET_KEY=change-me-to-a-random-64-char-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Active Directory (used by collector/ad_collector.py)
AD_SERVER=ldap://dc01.corp.local
AD_BIND_DN=CN=svc-lancompliance,OU=ServiceAccounts,DC=corp,DC=local
AD_BIND_PASSWORD=change-me
AD_BASE_DN=DC=corp,DC=local

# WinRM credentials for endpoint posture polling (a low-privilege domain account
# with "Remote Management Users" group membership on target machines)
WINRM_USERNAME=corp\\svc-lancompliance
WINRM_PASSWORD=change-me

# LAN CIDR for the rogue-device network scan
NETWORK_CIDR=192.168.1.0/24
